# Dependencies (reinstall with: npm install)
node_modules/

# Electron / electron-builder output
release/installer/win-unpacked/
release/installer/.icon-ico/
release/installer/*.blockmap
release/installer/builder-debug.yml
release/installer/__uninstaller-*
dist/
out/

# Keep Setup .exe out of git — attach on GitHub Releases instead
release/installer/*.exe

# Optional synced copy (regenerate: npm run sync-release)
release/source/

# Logs / OS junk
*.log
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
.cache/
