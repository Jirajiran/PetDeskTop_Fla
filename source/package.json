{
  "name": "fla-pet-desktop",
  "version": "32.0.0",
  "description": "Fla_petDesktop_V32 — desktop pet",
  "main": "main.js",
  "author": "Fla",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fla.petdesktop",
    "productName": "Fla_petDesktop_V32",
    "copyright": "Copyright © Fla",
    "directories": {
      "output": "..",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "pet.js",
      "index.html",
      "style.css",
      "PetPicture/**/*",
      "Sound/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Fla_petDesktop_V32-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Fla_petDesktop_V32",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerLanguages": [
        "th_TH",
        "en_US"
      ],
      "language": "1054"
    }
  }
}
